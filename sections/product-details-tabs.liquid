{%- liquid
  assign theme_rtl = false
  if settings.enable_rtl and settings.langauges_rtl == blank
    assign theme_rtl = true
  endif

  if settings.enable_rtl and settings.langauges_rtl != blank
    assign rtl_languages = settings.langauges_rtl | split: ','
    for language in rtl_languages
      if language == request.locale.iso_code
        assign theme_rtl = true
      endif
    endfor
  endif
-%}
{{ 'product-tab-list.css' | asset_url | stylesheet_tag }}
{% if theme_rtl %}
  {{ 'product-tab-list-rtl.css' | asset_url | stylesheet_tag }}
{% endif %}

<script src="{{ 'tab-active.js' | asset_url }}" defer></script>
<script src="{{ 'empty_unique_tab.js' | asset_url }}" defer></script>
<style>
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    margin-top: {{ section.settings.mobile_margin_top }}px;
    margin-bottom: {{ section.settings.mobile_margin_bottom }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }}-padding {
      margin-top: -1.4rem !important;
      padding-top: 0 !important;
    }

    .section-{{ section.id }}-padding .product_tab_list {
      margin-bottom: 1rem;
    }

    .section-{{ section.id }}-padding .product_tab_list li {
      padding-top: 0.2rem;
      padding-bottom: 0.4rem;
      margin-bottom: 0;
    }
  }

  #product_all .product-description-collapse {
    position: relative;
    overflow: hidden;
    max-height: 48rem;
    transition: max-height 0.3s ease;
  }

  #product_all .product-description-collapse.is-expanded {
    max-height: 200rem;
  }

  #product_all .product-description-collapse:not(.is-expanded)::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 22rem;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0), rgba(var(--color-background), 1));
  }

  #product_all .product-description-actions {
    margin-top: 1.2rem;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  #product_all .product-description-toggle {
    border: 0;
    background: transparent;
    color: #1e3a8a;
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.2;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.18rem;
    text-align: center;
  }

  #product_all .product-description-separator {
    display: block !important;
    width: 100% !important;
    height: 0 !important;
    margin: 1.2rem 0 0 !important;
    border: 0 !important;
    border-top: 2px solid #b6bec9 !important;
  }

  @media screen and (max-width: 749px) {
    #product_all .product-description-actions {
      margin-bottom: 0 !important;
    }

    #product_all .product-description-separator {
      margin: 0.9rem 0 0 !important;
      border-top: 2px solid #aeb7c3 !important;
    }
  }
</style>
{%- liquid
  assign container = ''
  if section.settings.container == 'container'
    assign container = 'container'
  elsif section.settings.container == 'container-fluid'
    assign container = 'container-fluid'
  else
    assign container = 'container-fluid px-0'
  endif
-%}

<div
  class="section section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="product-tab"
>
  <div class="{{ container }}">
    <ul class="product_tab_list ">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'product_description' -%}
            <li
              class="product_tab_list__li {% if forloop.first == true %} active {% endif %} h4"
              data-toggle="tab"
              data-target="#product_all"
            >
              {{ block.settings.header }}
            </li>
          {%- when 'reviews' -%}
            <li
              class="product_tab_list__li {% if forloop.first == true %} active {% endif %} h4"
              data-toggle="tab"
              data-target="#product_new"
            >
              {{ block.settings.header }}
            </li>
          {%- when 'custom_content' -%}
            <li
              class="product_tab_list__li {% if forloop.first == true %} active {% endif %} h4"
              data-toggle="tab"
              data-target="#custom_content-{{ block.id }}"
            >
              {{ block.settings.header }}
            </li>
          {%- when 'custom_liquid' -%}
            <li
              class="product_tab_list__li {% if forloop.first == true %} active {% endif %} h4"
              data-toggle="tab"
              data-target="#custom_liquid-{{ block.id }}"
            >
              {{ block.settings.header }}
            </li>
          {%- when 'unique_tab' -%}
            <li
              class="product_tab_list__li {% if forloop.first == true %} active {% endif %} h4"
              data-toggle="tab"
              data-unique="unique_tab-{{ block.id }}"
              data-target="#unique_tab-{{ block.id }}"
            >
              {{ block.settings.header }}
            </li>
        {%- endcase -%}
      {%- endfor -%}
    </ul>

    <div class="tab_content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'product_description' -%}
            {%- liquid
              assign product_description_sanitized = product.description
              assign product_description_sanitized = product_description_sanitized | replace: 'https://www.youtube.com/embed/', 'https://www.youtube-nocookie.com/embed/'
              assign product_description_sanitized = product_description_sanitized | replace: '//www.youtube.com/embed/', '//www.youtube-nocookie.com/embed/'
            -%}
            <div id="product_all" class="tab_pane active {% if forloop.first == true %} show {% endif %}">
              <div class="product-description-collapse" data-collapsed-height="480">
                {{ product_description_sanitized }}
              </div>
              <div class="product-description-actions">
                <button
                  type="button"
                  class="product-description-toggle"
                  aria-expanded="false"
                  data-expand-text="Vezi toată descrierea"
                  data-collapse-text="Închide descrierea"
                >
                  Vezi toată descrierea
                </button>
              </div>
              <hr class="product-description-separator" aria-hidden="true">
            </div>
          {%- when 'reviews' -%}
            <div id="product_new" class="tab_pane {% if forloop.first == true %} show {% endif %}">
              <div class="product__review_inner">
                {%- assign custom_review = block.settings.custom_liquid_review -%}
                {%- if custom_review != blank -%}
                  {{ custom_review }}
                {%- else -%}
                  <div style="clear:both"></div>
                  <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-id="{{ product.id }}">
                    {{ product.metafields.judgeme.widget }}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- when 'custom_content' -%}
            <div id="custom_content-{{ block.id }}" class="tab_pane {% if forloop.first == true %} show {% endif %}">
              {{ block.settings.content }}
              {{ block.settings.content_page.content }}
            </div>
          {%- when 'custom_liquid' -%}
            <div id="custom_liquid-{{ block.id }}" class="tab_pane {% if forloop.first == true %} show {% endif %}">
              {{ block.settings.custom_liquid }}
            </div>
          {%- when 'unique_tab' -%}
            <div
              id="unique_tab-{{ block.id }}"
              class="tab_pane {% if forloop.first == true %} show {% endif %} unique__tab-item"
            >
              {{ block.settings.unique_tab_liquid }}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var container = document.getElementById('product_all');
    if (!container) return;

    var collapse = container.querySelector('.product-description-collapse');
    var toggle = container.querySelector('.product-description-toggle');
    if (!collapse || !toggle) return;

    toggle.addEventListener('click', function () {
      var expanded = collapse.classList.toggle('is-expanded');
      toggle.setAttribute('aria-expanded', String(expanded));
      toggle.textContent = expanded ? toggle.dataset.collapseText : toggle.dataset.expandText;

      if (!expanded) {
        container.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  });
</script>

