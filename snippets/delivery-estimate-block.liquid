{%- liquid
  assign min_days = block.settings.delivery_days_min | default: 1 | plus: 0
  assign max_days = block.settings.delivery_days_max | default: 2 | plus: 0
  assign day_seconds = 86400
  assign now_timestamp = 'now' | date: '%s' | plus: 0

  if max_days < min_days
    assign swap_days = min_days
    assign min_days = max_days
    assign max_days = swap_days
  endif

  assign min_remaining = min_days
  assign min_start_offset = 0
  if min_days > 0
    assign min_start_offset = 1
  endif
  assign min_timestamp = now_timestamp

  for i in (0..120)
    if i >= min_start_offset
      assign offset_seconds = i | times: day_seconds
      assign candidate_timestamp = now_timestamp | plus: offset_seconds
      assign candidate_weekday = candidate_timestamp | date: '%u'
      assign is_non_delivery_day = false

      case candidate_weekday
        when '1'
          if block.settings.non_delivery_monday
            assign is_non_delivery_day = true
          endif
        when '2'
          if block.settings.non_delivery_tuesday
            assign is_non_delivery_day = true
          endif
        when '3'
          if block.settings.non_delivery_wednesday
            assign is_non_delivery_day = true
          endif
        when '4'
          if block.settings.non_delivery_thursday
            assign is_non_delivery_day = true
          endif
        when '5'
          if block.settings.non_delivery_friday
            assign is_non_delivery_day = true
          endif
        when '6'
          if block.settings.non_delivery_saturday
            assign is_non_delivery_day = true
          endif
        when '7'
          if block.settings.non_delivery_sunday
            assign is_non_delivery_day = true
          endif
      endcase

      unless is_non_delivery_day
        if min_remaining > 0
          assign min_remaining = min_remaining | minus: 1
          if min_remaining == 0
            assign min_timestamp = candidate_timestamp
            break
          endif
        else
          assign min_timestamp = candidate_timestamp
          break
        endif
      endunless
    endif
  endfor

  assign max_remaining = max_days
  assign max_start_offset = 0
  if max_days > 0
    assign max_start_offset = 1
  endif
  assign max_timestamp = min_timestamp

  for i in (0..120)
    if i >= max_start_offset
      assign offset_seconds = i | times: day_seconds
      assign candidate_timestamp = now_timestamp | plus: offset_seconds
      assign candidate_weekday = candidate_timestamp | date: '%u'
      assign is_non_delivery_day = false

      case candidate_weekday
        when '1'
          if block.settings.non_delivery_monday
            assign is_non_delivery_day = true
          endif
        when '2'
          if block.settings.non_delivery_tuesday
            assign is_non_delivery_day = true
          endif
        when '3'
          if block.settings.non_delivery_wednesday
            assign is_non_delivery_day = true
          endif
        when '4'
          if block.settings.non_delivery_thursday
            assign is_non_delivery_day = true
          endif
        when '5'
          if block.settings.non_delivery_friday
            assign is_non_delivery_day = true
          endif
        when '6'
          if block.settings.non_delivery_saturday
            assign is_non_delivery_day = true
          endif
        when '7'
          if block.settings.non_delivery_sunday
            assign is_non_delivery_day = true
          endif
      endcase

      unless is_non_delivery_day
        if max_remaining > 0
          assign max_remaining = max_remaining | minus: 1
          if max_remaining == 0
            assign max_timestamp = candidate_timestamp
            break
          endif
        else
          assign max_timestamp = candidate_timestamp
          break
        endif
      endunless
    endif
  endfor

  assign start_weekday = 'luni'
  assign end_weekday = 'luni'
  assign start_weekday_number = min_timestamp | date: '%u'
  assign end_weekday_number = max_timestamp | date: '%u'

  case start_weekday_number
    when '1'
      assign start_weekday = 'luni'
    when '2'
      assign start_weekday = 'marti'
    when '3'
      assign start_weekday = 'miercuri'
    when '4'
      assign start_weekday = 'joi'
    when '5'
      assign start_weekday = 'vineri'
    when '6'
      assign start_weekday = 'sambata'
    when '7'
      assign start_weekday = 'duminica'
  endcase

  case end_weekday_number
    when '1'
      assign end_weekday = 'luni'
    when '2'
      assign end_weekday = 'marti'
    when '3'
      assign end_weekday = 'miercuri'
    when '4'
      assign end_weekday = 'joi'
    when '5'
      assign end_weekday = 'vineri'
    when '6'
      assign end_weekday = 'sambata'
    when '7'
      assign end_weekday = 'duminica'
  endcase

  assign start_day_number = min_timestamp | date: '%d' | plus: 0
  assign end_day_number = max_timestamp | date: '%d' | plus: 0
  assign start_month_number = min_timestamp | date: '%m'
  assign end_month_number = max_timestamp | date: '%m'

  assign start_month_name = 'ianuarie'
  assign end_month_name = 'ianuarie'

  case start_month_number
    when '01'
      assign start_month_name = 'ianuarie'
    when '02'
      assign start_month_name = 'februarie'
    when '03'
      assign start_month_name = 'martie'
    when '04'
      assign start_month_name = 'aprilie'
    when '05'
      assign start_month_name = 'mai'
    when '06'
      assign start_month_name = 'iunie'
    when '07'
      assign start_month_name = 'iulie'
    when '08'
      assign start_month_name = 'august'
    when '09'
      assign start_month_name = 'septembrie'
    when '10'
      assign start_month_name = 'octombrie'
    when '11'
      assign start_month_name = 'noiembrie'
    when '12'
      assign start_month_name = 'decembrie'
  endcase

  case end_month_number
    when '01'
      assign end_month_name = 'ianuarie'
    when '02'
      assign end_month_name = 'februarie'
    when '03'
      assign end_month_name = 'martie'
    when '04'
      assign end_month_name = 'aprilie'
    when '05'
      assign end_month_name = 'mai'
    when '06'
      assign end_month_name = 'iunie'
    when '07'
      assign end_month_name = 'iulie'
    when '08'
      assign end_month_name = 'august'
    when '09'
      assign end_month_name = 'septembrie'
    when '10'
      assign end_month_name = 'octombrie'
    when '11'
      assign end_month_name = 'noiembrie'
    when '12'
      assign end_month_name = 'decembrie'
  endcase

  assign start_date_short = start_day_number | append: ' ' | append: start_month_name
  assign end_date_short = end_day_number | append: ' ' | append: end_month_name

  assign delivery_start_full = start_weekday | append: ', ' | append: start_date_short
  assign delivery_end_full = end_weekday | append: ', ' | append: end_date_short
  assign delivery_range = delivery_start_full
  if min_timestamp != max_timestamp
    assign delivery_range = delivery_start_full | append: ' - ' | append: delivery_end_full
  endif

  assign delivery_message_template = block.settings.delivery_message | default: 'Livrare estimata: {{ delivery_start_day }}, {{ delivery_start_date }} - {{ delivery_end_day }}, {{ delivery_end_date }}'
  assign start_day_strong = '<strong>' | append: start_weekday | append: '</strong>'
  assign start_date_strong = '<strong>' | append: start_date_short | append: '</strong>'
  assign end_day_strong = '<strong>' | append: end_weekday | append: '</strong>'
  assign end_date_strong = '<strong>' | append: end_date_short | append: '</strong>'
  assign range_strong = '<strong>' | append: delivery_range | append: '</strong>'

  assign delivery_message_rendered = delivery_message_template
  assign delivery_message_rendered = delivery_message_rendered | replace: '{{ delivery_start_day }}', start_day_strong
  assign delivery_message_rendered = delivery_message_rendered | replace: '{{ delivery_start_date }}', start_date_strong
  assign delivery_message_rendered = delivery_message_rendered | replace: '{{ delivery_end_day }}', end_day_strong
  assign delivery_message_rendered = delivery_message_rendered | replace: '{{ delivery_end_date }}', end_date_strong
  assign delivery_message_rendered = delivery_message_rendered | replace: '{{ delivery_range }}', range_strong
-%}

<style>
  .product-delivery-estimate {
    margin-top: 1.6rem;
    padding: 1.6rem;
    border: 1px solid {{ block.settings.delivery_border_color }};
    border-radius: 18px;
    background:
      radial-gradient(circle at 12% 8%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0) 42%),
      linear-gradient(145deg, {{ block.settings.delivery_bg_color }} 0%, #ffffff 100%);
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    box-shadow: 0 16px 34px rgba(18, 36, 56, 0.14);
  }

  .product-delivery-estimate__icon {
    width: 4.6rem;
    height: 4.6rem;
    flex: 0 0 4.6rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.delivery_icon_color }};
    background:
      radial-gradient(circle at 30% 26%, rgba(255, 255, 255, 0.96) 0%, rgba(255, 255, 255, 0.28) 34%, rgba(255, 255, 255, 0) 62%),
      linear-gradient(155deg, rgba(255, 255, 255, 0.46) 0%, {{ block.settings.delivery_icon_bg_color }} 42%, rgba(0, 0, 0, 0.12) 140%);
    box-shadow:
      inset 0 2px 6px rgba(255, 255, 255, 0.68),
      inset 0 -6px 10px rgba(0, 0, 0, 0.16),
      0 10px 16px rgba(12, 23, 35, 0.2);
  }

  .product-delivery-estimate__icon svg {
    width: 2.25rem;
    height: 2.25rem;
    display: block;
    filter: drop-shadow(0 1px 0 rgba(255, 255, 255, 0.55)) drop-shadow(0 2px 2px rgba(0, 0, 0, 0.2));
  }

  .product-delivery-estimate__title {
    margin: 0 0 0.45rem;
    font-size: 1.34rem;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: {{ block.settings.delivery_title_color }};
  }

  .product-delivery-estimate__range {
    margin: 0;
    font-size: 1.56rem;
    line-height: 1.42;
    font-weight: 800;
    color: {{ block.settings.delivery_text_color }};
  }

  .product-delivery-estimate__range strong {
    color: {{ block.settings.delivery_date_color }};
    font-weight: 900;
  }

  .product-delivery-estimate__note {
    margin: 0.7rem 0 0;
    font-size: 1.2rem;
    line-height: 1.4;
    font-weight: 600;
    color: {{ block.settings.delivery_note_color }};
  }

  @media screen and (max-width: 749px) {
    .product-delivery-estimate {
      padding: 1.15rem;
      gap: 0.75rem;
    }

    .product-delivery-estimate__icon {
      width: 3.9rem;
      height: 3.9rem;
      flex-basis: 3.9rem;
    }

    .product-delivery-estimate__icon svg {
      width: 1.95rem;
      height: 1.95rem;
    }

    .product-delivery-estimate__title {
      font-size: 1.16rem;
    }

    .product-delivery-estimate__range {
      font-size: 1.28rem;
    }

    .product-delivery-estimate__note {
      font-size: 1.06rem;
    }
  }
</style>

<div class="product-delivery-estimate" aria-label="Interval estimat de livrare">
  <span class="product-delivery-estimate__icon" aria-hidden="true">
    {%- case block.settings.delivery_icon -%}
      {%- when 'calendar' -%}
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M7 3v3M17 3v3M4 9h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <rect x="4" y="5" width="16" height="15" rx="2" stroke="currentColor" stroke-width="2"/>
          <path d="M9 13h2M13 13h2M9 17h2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      {%- when 'package' -%}
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 3 4 7v10l8 4 8-4V7l-8-4Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          <path d="M4 7l8 4 8-4M12 11v10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      {%- when 'clock' -%}
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/>
          <path d="M12 7v5l3 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      {%- else -%}
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 13h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M13 7h4l4 4v2h-8V7Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          <circle cx="7" cy="17" r="2" stroke="currentColor" stroke-width="2"/>
          <circle cx="17" cy="17" r="2" stroke="currentColor" stroke-width="2"/>
        </svg>
    {%- endcase -%}
  </span>

  <div class="product-delivery-estimate__content">
    <p class="product-delivery-estimate__title">{{ block.settings.delivery_title }}</p>
    <p class="product-delivery-estimate__range">{{ delivery_message_rendered }}</p>
    {%- if block.settings.delivery_note != blank -%}
      <p class="product-delivery-estimate__note">{{ block.settings.delivery_note }}</p>
    {%- endif -%}
  </div>
</div>
