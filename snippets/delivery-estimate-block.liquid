{%- liquid
  assign delivery_days = block.settings.delivery_days | default: 1 | plus: 0
  assign day_seconds = 86400
  assign now_timestamp = 'now' | date: '%s' | plus: 0
  assign remaining_working_days = delivery_days
  assign start_offset_days = 0

  if delivery_days > 0
    assign start_offset_days = 1
  endif

  assign estimated_timestamp = now_timestamp

  for i in (0..120)
    if i >= start_offset_days
      assign offset_seconds = i | times: day_seconds
      assign candidate_timestamp = now_timestamp | plus: offset_seconds
      assign candidate_weekday = candidate_timestamp | date: '%u'
      assign is_non_delivery_day = false

      case candidate_weekday
        when '1'
          if block.settings.non_delivery_monday
            assign is_non_delivery_day = true
          endif
        when '2'
          if block.settings.non_delivery_tuesday
            assign is_non_delivery_day = true
          endif
        when '3'
          if block.settings.non_delivery_wednesday
            assign is_non_delivery_day = true
          endif
        when '4'
          if block.settings.non_delivery_thursday
            assign is_non_delivery_day = true
          endif
        when '5'
          if block.settings.non_delivery_friday
            assign is_non_delivery_day = true
          endif
        when '6'
          if block.settings.non_delivery_saturday
            assign is_non_delivery_day = true
          endif
        when '7'
          if block.settings.non_delivery_sunday
            assign is_non_delivery_day = true
          endif
      endcase

      unless is_non_delivery_day
        if remaining_working_days > 0
          assign remaining_working_days = remaining_working_days | minus: 1
          if remaining_working_days == 0
            assign estimated_timestamp = candidate_timestamp
            break
          endif
        else
          assign estimated_timestamp = candidate_timestamp
          break
        endif
      endunless
    endif
  endfor

  assign delivery_weekday_number = estimated_timestamp | date: '%u'
  assign delivery_weekday_name = 'luni'

  case delivery_weekday_number
    when '1'
      assign delivery_weekday_name = 'luni'
    when '2'
      assign delivery_weekday_name = 'marti'
    when '3'
      assign delivery_weekday_name = 'miercuri'
    when '4'
      assign delivery_weekday_name = 'joi'
    when '5'
      assign delivery_weekday_name = 'vineri'
    when '6'
      assign delivery_weekday_name = 'sambata'
    when '7'
      assign delivery_weekday_name = 'duminica'
  endcase

  assign delivery_date = estimated_timestamp | date: '%d.%m.%Y'
  assign delivery_message_template = block.settings.delivery_message | default: 'Livrare estimata: {{ delivery_day }}, {{ delivery_date }}'
  assign delivery_message = delivery_message_template | replace: '{{ delivery_day }}', delivery_weekday_name | replace: '{{ delivery_date }}', delivery_date
  assign delivery_day_emphasized = '<strong>' | append: delivery_weekday_name | append: '</strong>'
  assign delivery_date_emphasized = '<strong>' | append: delivery_date | append: '</strong>'
  assign delivery_message_highlighted = delivery_message | replace: delivery_weekday_name, delivery_day_emphasized | replace: delivery_date, delivery_date_emphasized
-%}

<style>
  .product-delivery-estimate {
    margin-top: 1.6rem;
    padding: 1.15rem 1.2rem;
    border: 1px solid {{ block.settings.delivery_border_color }};
    border-radius: 12px;
    background: {{ block.settings.delivery_bg_color }};
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
  }

  .product-delivery-estimate__icon {
    width: 3.2rem;
    height: 3.2rem;
    flex: 0 0 3.2rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.delivery_icon_color }};
    background: {{ block.settings.delivery_icon_bg_color }};
  }

  .product-delivery-estimate__icon svg {
    width: 1.9rem;
    height: 1.9rem;
    display: block;
  }

  .product-delivery-estimate__text {
    margin: 0;
    font-size: 1.35rem;
    line-height: 1.45;
    font-weight: 700;
    color: {{ block.settings.delivery_text_color }};
  }

  .product-delivery-estimate__text strong {
    color: {{ block.settings.delivery_date_color }};
    font-weight: 800;
  }

  @media screen and (max-width: 749px) {
    .product-delivery-estimate {
      padding: 1rem;
      gap: 0.75rem;
    }

    .product-delivery-estimate__text {
      font-size: 1.24rem;
    }
  }
</style>

<div class="product-delivery-estimate" aria-label="Data estimata de livrare">
  <span class="product-delivery-estimate__icon" aria-hidden="true">
    {%- case block.settings.delivery_icon -%}
      {%- when 'calendar' -%}
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M7 3v3M17 3v3M4 9h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <rect x="4" y="5" width="16" height="15" rx="2" stroke="currentColor" stroke-width="2"/>
          <path d="M9 13h2M13 13h2M9 17h2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      {%- when 'package' -%}
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 3 4 7v10l8 4 8-4V7l-8-4Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          <path d="M4 7l8 4 8-4M12 11v10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      {%- when 'clock' -%}
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/>
          <path d="M12 7v5l3 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      {%- else -%}
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 13h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M13 7h4l4 4v2h-8V7Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
          <circle cx="7" cy="17" r="2" stroke="currentColor" stroke-width="2"/>
          <circle cx="17" cy="17" r="2" stroke="currentColor" stroke-width="2"/>
        </svg>
    {%- endcase -%}
  </span>
  <p class="product-delivery-estimate__text">
    {{ delivery_message_highlighted }}
  </p>
</div>
