{%- liquid
  assign min_days = block.settings.delivery_days_min | default: 1 | plus: 0
  assign max_days = block.settings.delivery_days_max | default: 2 | plus: 0
  assign day_seconds = 86400
  assign now_timestamp = 'now' | date: '%s' | plus: 0
  assign now_hour = 'now' | date: '%H' | plus: 0
  assign now_minute = 'now' | date: '%M' | plus: 0
  assign current_minutes = now_hour | times: 60 | plus: now_minute
  assign cutoff_hour = block.settings.delivery_cutoff_hour | default: 15 | plus: 0
  assign cutoff_minute = block.settings.delivery_cutoff_minute | default: 30 | plus: 0
  assign cutoff_minutes = cutoff_hour | times: 60 | plus: cutoff_minute
  assign cutoff_enabled = block.settings.delivery_cutoff_enabled
  assign offset_x = block.settings.delivery_offset_x | default: 120 | plus: 0 | minus: 120
  assign offset_y = block.settings.delivery_offset_y | default: 120 | plus: 0 | minus: 120
  assign padding_top = block.settings.delivery_padding_top | default: 16 | plus: 0
  assign padding_bottom = block.settings.delivery_padding_bottom | default: 16 | plus: 0
  assign non_delivery_saturday = block.settings.non_delivery_saturday
  assign non_delivery_sunday = block.settings.non_delivery_sunday

  if non_delivery_saturday == blank
    assign non_delivery_saturday = true
  endif

  if non_delivery_sunday == blank
    assign non_delivery_sunday = true
  endif

  if cutoff_enabled == blank
    assign cutoff_enabled = true
  endif

  if cutoff_enabled and current_minutes >= cutoff_minutes
    assign now_timestamp = now_timestamp | plus: day_seconds
  endif

  if max_days < min_days
    assign swap_days = min_days
    assign min_days = max_days
    assign max_days = swap_days
  endif

  assign min_remaining = min_days
  assign min_start_offset = 0
  if min_days > 0
    assign min_start_offset = 1
  endif
  assign min_timestamp = now_timestamp

  for i in (0..120)
    if i >= min_start_offset
      assign offset_seconds = i | times: day_seconds
      assign candidate_timestamp = now_timestamp | plus: offset_seconds
      assign candidate_weekday = candidate_timestamp | date: '%u'
      assign is_non_delivery_day = false

      case candidate_weekday
        when '1'
          if block.settings.non_delivery_monday
            assign is_non_delivery_day = true
          endif
        when '2'
          if block.settings.non_delivery_tuesday
            assign is_non_delivery_day = true
          endif
        when '3'
          if block.settings.non_delivery_wednesday
            assign is_non_delivery_day = true
          endif
        when '4'
          if block.settings.non_delivery_thursday
            assign is_non_delivery_day = true
          endif
        when '5'
          if block.settings.non_delivery_friday
            assign is_non_delivery_day = true
          endif
        when '6'
          if non_delivery_saturday
            assign is_non_delivery_day = true
          endif
        when '7'
          if non_delivery_sunday
            assign is_non_delivery_day = true
          endif
      endcase

      unless is_non_delivery_day
        if min_remaining > 0
          assign min_remaining = min_remaining | minus: 1
          if min_remaining == 0
            assign min_timestamp = candidate_timestamp
            break
          endif
        else
          assign min_timestamp = candidate_timestamp
          break
        endif
      endunless
    endif
  endfor

  assign max_remaining = max_days
  assign max_start_offset = 0
  if max_days > 0
    assign max_start_offset = 1
  endif
  assign max_timestamp = min_timestamp

  for i in (0..120)
    if i >= max_start_offset
      assign offset_seconds = i | times: day_seconds
      assign candidate_timestamp = now_timestamp | plus: offset_seconds
      assign candidate_weekday = candidate_timestamp | date: '%u'
      assign is_non_delivery_day = false

      case candidate_weekday
        when '1'
          if block.settings.non_delivery_monday
            assign is_non_delivery_day = true
          endif
        when '2'
          if block.settings.non_delivery_tuesday
            assign is_non_delivery_day = true
          endif
        when '3'
          if block.settings.non_delivery_wednesday
            assign is_non_delivery_day = true
          endif
        when '4'
          if block.settings.non_delivery_thursday
            assign is_non_delivery_day = true
          endif
        when '5'
          if block.settings.non_delivery_friday
            assign is_non_delivery_day = true
          endif
        when '6'
          if non_delivery_saturday
            assign is_non_delivery_day = true
          endif
        when '7'
          if non_delivery_sunday
            assign is_non_delivery_day = true
          endif
      endcase

      unless is_non_delivery_day
        if max_remaining > 0
          assign max_remaining = max_remaining | minus: 1
          if max_remaining == 0
            assign max_timestamp = candidate_timestamp
            break
          endif
        else
          assign max_timestamp = candidate_timestamp
          break
        endif
      endunless
    endif
  endfor

  assign start_weekday = 'luni'
  assign end_weekday = 'luni'
  assign start_weekday_number = min_timestamp | date: '%u'
  assign end_weekday_number = max_timestamp | date: '%u'

  case start_weekday_number
    when '1'
      assign start_weekday = 'luni'
    when '2'
      assign start_weekday = 'marti'
    when '3'
      assign start_weekday = 'miercuri'
    when '4'
      assign start_weekday = 'joi'
    when '5'
      assign start_weekday = 'vineri'
    when '6'
      assign start_weekday = 'sambata'
    when '7'
      assign start_weekday = 'duminica'
  endcase

  case end_weekday_number
    when '1'
      assign end_weekday = 'luni'
    when '2'
      assign end_weekday = 'marti'
    when '3'
      assign end_weekday = 'miercuri'
    when '4'
      assign end_weekday = 'joi'
    when '5'
      assign end_weekday = 'vineri'
    when '6'
      assign end_weekday = 'sambata'
    when '7'
      assign end_weekday = 'duminica'
  endcase

  assign start_day_number = min_timestamp | date: '%d' | plus: 0
  assign end_day_number = max_timestamp | date: '%d' | plus: 0
  assign start_month_number = min_timestamp | date: '%m'
  assign end_month_number = max_timestamp | date: '%m'

  assign start_month_name = 'ianuarie'
  assign end_month_name = 'ianuarie'

  case start_month_number
    when '01'
      assign start_month_name = 'ianuarie'
    when '02'
      assign start_month_name = 'februarie'
    when '03'
      assign start_month_name = 'martie'
    when '04'
      assign start_month_name = 'aprilie'
    when '05'
      assign start_month_name = 'mai'
    when '06'
      assign start_month_name = 'iunie'
    when '07'
      assign start_month_name = 'iulie'
    when '08'
      assign start_month_name = 'august'
    when '09'
      assign start_month_name = 'septembrie'
    when '10'
      assign start_month_name = 'octombrie'
    when '11'
      assign start_month_name = 'noiembrie'
    when '12'
      assign start_month_name = 'decembrie'
  endcase

  case end_month_number
    when '01'
      assign end_month_name = 'ianuarie'
    when '02'
      assign end_month_name = 'februarie'
    when '03'
      assign end_month_name = 'martie'
    when '04'
      assign end_month_name = 'aprilie'
    when '05'
      assign end_month_name = 'mai'
    when '06'
      assign end_month_name = 'iunie'
    when '07'
      assign end_month_name = 'iulie'
    when '08'
      assign end_month_name = 'august'
    when '09'
      assign end_month_name = 'septembrie'
    when '10'
      assign end_month_name = 'octombrie'
    when '11'
      assign end_month_name = 'noiembrie'
    when '12'
      assign end_month_name = 'decembrie'
  endcase

  assign start_date_short = start_day_number | append: ' ' | append: start_month_name
  assign end_date_short = end_day_number | append: ' ' | append: end_month_name

  assign delivery_start_full = start_weekday | append: ', ' | append: start_date_short
  assign delivery_end_full = end_weekday | append: ', ' | append: end_date_short
  assign delivery_range = delivery_start_full
  if min_timestamp != max_timestamp
    assign delivery_range = delivery_start_full | append: ' - ' | append: delivery_end_full
  endif

  assign delivery_label = block.settings.delivery_label | strip
  assign delivery_interval_prefix = block.settings.delivery_interval_prefix | strip
  assign delivery_title = block.settings.delivery_title | strip
  assign visual_preset = block.settings.delivery_visual_preset | default: 'premium'
  assign delivery_mode = block.settings.delivery_mode | default: 'delivery'
  assign trust_icon_size = block.settings.delivery_trust_icon_size | default: 40
  assign trust_logo_height = block.settings.delivery_trust_logo_height | default: 24
  assign trust_icon_bg = block.settings.delivery_trust_icon_bg | default: '#f3f4f6'
  assign has_trust_logos = false
  if block.settings.delivery_trust_logo_1 != blank or block.settings.delivery_trust_logo_2 != blank or block.settings.delivery_trust_logo_3 != blank
    assign has_trust_logos = true
  endif
  assign title_color = block.settings.delivery_title_color | default: settings.delivery_global_title_color | default: '#000000'
  assign label_color = block.settings.delivery_label_color | default: settings.delivery_global_label_color | default: block.settings.delivery_text_color | default: '#166A31'
  assign prefix_color = block.settings.delivery_prefix_color | default: settings.delivery_global_prefix_color | default: block.settings.delivery_text_color | default: '#1A2430'
  assign date_color = block.settings.delivery_date_color | default: settings.delivery_global_date_color | default: '#C93131'
  assign note_color = block.settings.delivery_note_color | default: settings.delivery_global_note_color | default: '#166A31'
  assign icon_bg_color = block.settings.delivery_icon_bg_color | default: '#FFFFFF'
  assign block_bg_color = block.settings.delivery_bg_color | default: settings.delivery_global_bg_color | default: '#F3F3F3'
  assign border_color = block.settings.delivery_border_color | default: settings.delivery_global_border_color | default: '#337239'

  assign delivery_emoji = '🚚'
  case block.settings.delivery_icon
    when 'calendar'
      assign delivery_emoji = '📅'
    when 'package'
      assign delivery_emoji = '📦'
    when 'clock'
      assign delivery_emoji = '⏱️'
    when 'truck'
      assign delivery_emoji = '🚚'
  endcase
-%}

<style>
  .product-delivery-estimate {
    --delivery-title-size: {{ block.settings.delivery_title_size | default: 13 }}px;
    --delivery-label-size: 12px;
    --delivery-range-size: {{ block.settings.delivery_range_size | default: 16 }}px;
    --delivery-note-size: {{ block.settings.delivery_note_size | default: 12 }}px;
    --delivery-icon-size: {{ block.settings.delivery_icon_size | default: 50 }}px;
    --delivery-emoji-size: {{ block.settings.delivery_emoji_size | default: 40 }}px;

    margin-top: 0;
    margin-left: {{ offset_x }}px;
    padding: {{ padding_top }}px 1.6rem {{ padding_bottom }}px;
    border: 1px solid {{ border_color }};
    border-radius: 0;
    background:
      radial-gradient(circle at 12% 8%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0) 42%),
      linear-gradient(145deg, {{ block_bg_color }} 0%, #ffffff 100%);
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    box-shadow: none;
    transform: translateY({{ offset_y }}px);
  }

  .product-delivery-estimate--clean {
    border-radius: 0;
    background: #ffffff;
    box-shadow: none;
  }

  .product-delivery-estimate--clean .product-delivery-estimate__icon {
    box-shadow: none;
  }

  .product-delivery-estimate--outline {
    border-width: 2px;
    border-style: dashed;
    border-radius: 0;
    background: linear-gradient(145deg, #ffffff 0%, {{ block_bg_color }} 100%);
    box-shadow: none;
  }

  .product-delivery-estimate--strong {
    border-radius: 0;
    background:
      radial-gradient(circle at 85% 10%, rgba(255, 255, 255, 0.55) 0%, rgba(255, 255, 255, 0) 38%),
      linear-gradient(145deg, {{ block_bg_color }} 0%, #e7f0ff 100%);
    box-shadow: none;
  }

  .product-delivery-estimate__icon {
    width: var(--delivery-icon-size);
    height: var(--delivery-icon-size);
    flex: 0 0 var(--delivery-icon-size);
    border-radius: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(circle at 30% 26%, rgba(255, 255, 255, 0.96) 0%, rgba(255, 255, 255, 0.28) 34%, rgba(255, 255, 255, 0) 62%),
      linear-gradient(155deg, rgba(255, 255, 255, 0.46) 0%, {{ icon_bg_color }} 42%, rgba(0, 0, 0, 0.12) 140%);
    box-shadow: none;
  }

  .product-delivery-estimate__emoji {
    font-size: var(--delivery-emoji-size);
    line-height: 1;
    transform: translateY(-1px);
    text-shadow: none;
  }

  .product-delivery-estimate__title {
    margin: 0 0 0.45rem;
    font-size: var(--delivery-title-size);
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: {{ title_color }};
  }

  .product-delivery-estimate__label {
    margin: 0;
    font-size: var(--delivery-label-size);
    line-height: 1.35;
    font-weight: 700;
    color: {{ label_color }};
  }

  .product-delivery-estimate__range {
    margin: 0.3rem 0 0;
    font-size: var(--delivery-range-size);
    line-height: 1.42;
    font-weight: 800;
    color: {{ prefix_color }};
  }

  .product-delivery-estimate__range-date {
    color: {{ date_color }};
  }

  .product-delivery-estimate__note {
    margin: 0.7rem 0 0;
    font-size: var(--delivery-note-size);
    line-height: 1.4;
    font-weight: 600;
    color: {{ note_color }};
  }

  @media screen and (max-width: 749px) {
    .product-delivery-estimate {
      margin-top: 0;
      margin-left: {{ offset_x }}px;
      padding: {{ padding_top }}px 1.6rem {{ padding_bottom }}px;
      gap: 1.25rem;
      transform: translateY({{ offset_y }}px);
    }

    .product-delivery-estimate__icon {
      width: var(--delivery-icon-size);
      height: var(--delivery-icon-size);
      flex-basis: var(--delivery-icon-size);
    }
  }
</style>

<div class="product-delivery-estimate product-delivery-estimate--{{ visual_preset }}" aria-label="Interval estimat de livrare">
  {% if delivery_mode == 'trust' %}
    <span class="product-delivery-estimate__icon" aria-hidden="true" style="background: {{ trust_icon_bg }};">
      {% if block.settings.delivery_trust_icon != blank %}
        {{ block.settings.delivery_trust_icon | image_url: width: 128 | image_tag: loading: 'lazy', widths: '64,96,128', style: 'width: ' | append: trust_icon_size | append: 'px; height: ' | append: trust_icon_size | append: 'px; object-fit: contain;' }}
      {% else %}
        <span class="product-delivery-estimate__emoji">🔒</span>
      {% endif %}
    </span>
  {% else %}
    <span class="product-delivery-estimate__icon" aria-hidden="true">
      <span class="product-delivery-estimate__emoji">{{ delivery_emoji }}</span>
    </span>
  {% endif %}

  <div class="product-delivery-estimate__content">
    {%- if delivery_title != blank -%}
      <p class="product-delivery-estimate__title">{{ delivery_title }}</p>
    {%- endif -%}
    {%- if delivery_label != blank -%}
      <p class="product-delivery-estimate__label">{{ delivery_label }}</p>
    {%- endif -%}
    {% if delivery_mode == 'trust' %}
      {%- if block.settings.delivery_note != blank -%}
        <p class="product-delivery-estimate__note">{{ block.settings.delivery_note }}</p>
      {%- endif -%}
      {% if has_trust_logos %}
        <div style="display: flex; gap: 0.5rem; margin-top: 0.65rem; flex-wrap: wrap; align-items: center;">
          {% if block.settings.delivery_trust_logo_1 != blank %}
            {{ block.settings.delivery_trust_logo_1 | image_url: width: 180 | image_tag: loading: 'lazy', widths: '120,180', style: 'height: ' | append: trust_logo_height | append: 'px; width: auto; object-fit: contain;' }}
          {% endif %}
          {% if block.settings.delivery_trust_logo_2 != blank %}
            {{ block.settings.delivery_trust_logo_2 | image_url: width: 180 | image_tag: loading: 'lazy', widths: '120,180', style: 'height: ' | append: trust_logo_height | append: 'px; width: auto; object-fit: contain;' }}
          {% endif %}
          {% if block.settings.delivery_trust_logo_3 != blank %}
            {{ block.settings.delivery_trust_logo_3 | image_url: width: 180 | image_tag: loading: 'lazy', widths: '120,180', style: 'height: ' | append: trust_logo_height | append: 'px; width: auto; object-fit: contain;' }}
          {% endif %}
        </div>
      {% endif %}
    {% else %}
      <p class="product-delivery-estimate__range">
        {%- if delivery_interval_prefix != blank -%}
          {{ delivery_interval_prefix }}
        {%- endif -%}
        <span class="product-delivery-estimate__range-date">
          {% if min_timestamp == max_timestamp %}
            {{ delivery_start_full }}
          {% else %}
            {{ delivery_start_full }} - {{ delivery_end_full }}
          {% endif %}
        </span>
      </p>
      {%- if block.settings.delivery_note != blank -%}
        <p class="product-delivery-estimate__note">{{ block.settings.delivery_note }}</p>
      {%- endif -%}
    {% endif %}
  </div>
</div>
