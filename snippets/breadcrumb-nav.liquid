<nav role="navigation" aria-label="breadcrumbs">
  <ol class="breadcrumbs__list">
    {%- case t -%}
    {%- when 'page' -%}
    <li class="breadcrumbs__item">
      <a class="breadcrumbs__link" href="{{ page.url }}" aria-current="page">{{ page.title }}</a>
    </li>
    {%- when 'product' -%}
    {%- assign primary_collection = blank -%}
    {%- assign secondary_collection = blank -%}

    {%- assign context_collection_is_generic = false -%}
    {%- if collection != blank -%}
      {%- assign context_handle_downcase = collection.handle | downcase -%}
      {%- assign context_title_downcase = collection.title | downcase -%}
      {%- if context_handle_downcase == 'all'
        or context_handle_downcase == 'all-products'
        or context_handle_downcase == 'catalog'
        or context_handle_downcase == 'frontpage'
        or context_title_downcase contains 'all products'
        or context_title_downcase contains 'toate produsele'
      -%}
        {%- assign context_collection_is_generic = true -%}
      {%- endif -%}
    {%- endif -%}

    {%- if collection != blank and context_collection_is_generic == false -%}
      {%- assign primary_collection = collection -%}
    {%- endif -%}

    {%- if product.collections != blank and product.collections.size > 0 -%}
      {%- for product_collection in product.collections -%}
        {%- assign collection_handle_downcase = product_collection.handle | downcase -%}
        {%- assign collection_title_downcase = product_collection.title | downcase -%}
        {%- assign is_generic_collection = false -%}

        {%- if collection_handle_downcase == 'all'
          or collection_handle_downcase == 'all-products'
          or collection_handle_downcase == 'catalog'
          or collection_handle_downcase == 'frontpage'
          or collection_title_downcase contains 'all products'
          or collection_title_downcase contains 'toate produsele'
        -%}
          {%- assign is_generic_collection = true -%}
        {%- endif -%}

        {%- unless is_generic_collection -%}
          {%- if primary_collection == blank -%}
            {%- assign primary_collection = product_collection -%}
          {%- elsif secondary_collection == blank and product_collection.id != primary_collection.id -%}
            {%- assign primary_title_downcase = primary_collection.title | downcase -%}
            {%- assign candidate_title_downcase = product_collection.title | downcase -%}
            {%- assign candidate_handle_downcase = product_collection.handle | downcase -%}
            {%- assign primary_handle_downcase = primary_collection.handle | downcase -%}
            {%- if candidate_title_downcase != primary_title_downcase and candidate_handle_downcase != primary_handle_downcase -%}
              {%- assign secondary_collection = product_collection -%}
            {%- endif -%}
          {%- endif -%}
        {%- endunless -%}
      {%- endfor -%}
    {%- endif -%}

    {%- if primary_collection.url -%}
    <li class="breadcrumbs__item">
      {{ primary_collection.title | link_to: primary_collection.url }}
    </li>
    {%- endif -%}

    {%- if secondary_collection != blank and secondary_collection.url -%}
    <li class="breadcrumbs__item">
      {{ secondary_collection.title | link_to: secondary_collection.url }}
    </li>
    {%- endif -%}

    <li class="breadcrumbs__item">
      <a class="breadcrumbs__link" href="{{ product.url }}" aria-current="page">{{ product.title }}</a>
    </li>
    {%- when 'collection' and collection.handle -%}
    {%- if current_tags -%}
    <li class="breadcrumbs__item">
      {{ collection.title | link_to: collection.url }}
    </li>
    <li class="breadcrumbs__item">
      {%- capture tag_url -%}{{ collection.url }}/{{ current_tags | join: "+"}}{%- endcapture -%}
      <a class="breadcrumbs__link" href="{{ tag_url }}" aria-current="page">{{ current_tags | join: " + "}}</a>
    </li>
    {%- else -%}
    <li class="breadcrumbs__item">
      <a class="breadcrumbs__link" href="{{ collection.url }}" aria-current="page">{{ collection.title }}</a>
    </li>
    {%- endif -%}
    {%- when 'blog' -%}
    {%- if current_tags -%}
    <li class="breadcrumbs__item">
      {{ blog.title | link_to: blog.url }}
    </li>
    <li class="breadcrumbs__item">
      {%- capture tag_url -%}{{blog.url}}/tagged/{{ current_tags | join: "+" }}{%- endcapture -%}
      <a class="breadcrumbs__link" href="{{ tag_url }}" aria-current="page">{{ current_tags | join: " + " }}</a>
    </li>
    {%- else -%}
    <li class="breadcrumbs__item">
      <a class="breadcrumbs__link" href="{{ blog.url }}" aria-current="page">{{ blog.title }}</a>
    </li>
    {%- endif -%}
    {%- when 'article' -%}
    <li class="breadcrumbs__item">
      {{ blog.title | link_to: blog.url }}
    </li>
    <li class="breadcrumbs__item">
      <a class="breadcrumbs__link" href="{{ article.url }}" aria-current="page">{{ article.title }}</a>
    </li>
    {%- when 'customers/addresses' -%}
    <li class="breadcrumbs__item">
      <a href="{{ routes.account_url }}">
        {{ 'customer.account.title' | t }}
      </a>
    </li>
    <li class="breadcrumbs__item">
      {{ 'Adresss' }}
    </li>
    {%- when 'customers/account' -%} 
    <li class="breadcrumbs__item">
       {{ 'customer.account.title' | t }}
    </li>
    {%- else -%}
    <li class="breadcrumbs__item">
      <a class="breadcrumbs__link" href="{{ request.path }}" aria-current="page">{{ page_title }}</a>
    </li>
    {%- endcase -%}
  </ol>
</nav>