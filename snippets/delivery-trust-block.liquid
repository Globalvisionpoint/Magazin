{%- liquid
  assign has_logos = false
  if block.settings.trust_logo_1 != blank or block.settings.trust_logo_2 != blank or block.settings.trust_logo_3 != blank or block.settings.trust_logo_4 != blank or block.settings.trust_logo_5 != blank or block.settings.trust_logo_6 != blank
    assign has_logos = true
  endif
-%}

<style>
  .delivery-trust-block {
    border: 1px solid {{ block.settings.delivery_border_color | default: '#337239' }};
    border-radius: {{ block.settings.trust_corner_radius | default: 16 }}px;
    background:
      radial-gradient(circle at 14% 10%, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0) 38%),
      linear-gradient(180deg, {{ block.settings.delivery_bg_color | default: '#F3F3F3' }} 0%, #ffffff 100%);
    padding: {{ block.settings.trust_padding_y | default: 14 }}px 1.5rem;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
  }

  .delivery-trust-block__icon {
    width: {{ block.settings.trust_icon_size | default: 40 }}px;
    height: {{ block.settings.trust_icon_size | default: 40 }}px;
    min-width: {{ block.settings.trust_icon_size | default: 40 }}px;
    border-radius: 12px;
    background:
      radial-gradient(circle at 30% 24%, rgba(255, 255, 255, 0.88) 0%, rgba(255, 255, 255, 0) 56%),
      linear-gradient(180deg, {{ block.settings.trust_icon_background | default: '#f3f4f6' }} 0%, #ffffff 100%);
    color: {{ block.settings.trust_icon_color | default: '#111827' }};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .delivery-trust-block__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .delivery-trust-block__icon .icon,
  .delivery-trust-block__icon svg {
    width: 65%;
    height: 65%;
  }

  .delivery-trust-block__content {
    min-width: 0;
    flex: 1 1 auto;
  }

  .delivery-trust-block__title {
    margin: 0;
    color: {{ block.settings.delivery_title_color | default: '#000000' }};
    font-size: 1.95rem;
    line-height: 1.15;
    font-weight: 800;
  }

  .delivery-trust-block__subtitle {
    margin: 0.25rem 0 0;
    color: {{ block.settings.delivery_label_color | default: '#166A31' }};
    font-size: 1.48rem;
    line-height: 1.3;
    font-weight: 700;
  }

  .delivery-trust-block__note {
    margin: 0.45rem 0 0;
    color: {{ block.settings.delivery_note_color | default: '#166A31' }};
    font-size: 1.35rem;
    line-height: 1.4;
    font-weight: 600;
  }

  .delivery-trust-block__note-secondary {
    margin: 0.25rem 0 0;
    color: {{ block.settings.trust_note_secondary_color | default: '#4b5563' }};
    font-size: 1.2rem;
    line-height: 1.4;
    font-weight: 500;
  }

  .delivery-trust-block__logos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 0.8rem;
  }

  .delivery-trust-block__logo {
    min-width: calc({{ block.settings.trust_logo_height | default: 26 }}px * 1.5);
    height: calc({{ block.settings.trust_logo_height | default: 26 }}px + 10px);
    border-radius: 9px;
    border: 1px solid {{ block.settings.trust_logo_border_color | default: '#d6d9df' }};
    background: {{ block.settings.trust_logo_background | default: '#ffffff' }};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 0.75rem;
  }

  .delivery-trust-block__logo img {
    height: {{ block.settings.trust_logo_height | default: 26 }}px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  @media screen and (max-width: 749px) {
    .delivery-trust-block {
      padding: {{ block.settings.trust_padding_y | default: 14 }}px 1.2rem;
    }

    .delivery-trust-block__title {
      font-size: 1.8rem;
    }
  }
</style>

<div class="delivery-trust-block" aria-label="Trust badges block">
  <span class="delivery-trust-block__icon" aria-hidden="true">
    {%- if block.settings.trust_custom_icon != blank -%}
      {{ block.settings.trust_custom_icon | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80,120,160', alt: block.settings.delivery_title }}
    {%- else -%}
      {% render 'icon-padlock' %}
    {%- endif -%}
  </span>

  <div class="delivery-trust-block__content">
    {%- if block.settings.delivery_title != blank -%}
      <p class="delivery-trust-block__title">{{ block.settings.delivery_title }}</p>
    {%- endif -%}

    {%- if block.settings.delivery_label != blank -%}
      <p class="delivery-trust-block__subtitle">{{ block.settings.delivery_label }}</p>
    {%- endif -%}

    {%- if block.settings.delivery_note != blank -%}
      <p class="delivery-trust-block__note">{{ block.settings.delivery_note }}</p>
    {%- endif -%}

    {%- if block.settings.trust_note_secondary != blank -%}
      <p class="delivery-trust-block__note-secondary">{{ block.settings.trust_note_secondary }}</p>
    {%- endif -%}

    {%- if has_logos -%}
      <div class="delivery-trust-block__logos" aria-label="Card logos">
        {%- if block.settings.trust_logo_1 != blank -%}
          <span class="delivery-trust-block__logo">{{ block.settings.trust_logo_1 | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90,120,180', alt: block.settings.delivery_title }}</span>
        {%- endif -%}
        {%- if block.settings.trust_logo_2 != blank -%}
          <span class="delivery-trust-block__logo">{{ block.settings.trust_logo_2 | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90,120,180', alt: block.settings.delivery_title }}</span>
        {%- endif -%}
        {%- if block.settings.trust_logo_3 != blank -%}
          <span class="delivery-trust-block__logo">{{ block.settings.trust_logo_3 | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90,120,180', alt: block.settings.delivery_title }}</span>
        {%- endif -%}
        {%- if block.settings.trust_logo_4 != blank -%}
          <span class="delivery-trust-block__logo">{{ block.settings.trust_logo_4 | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90,120,180', alt: block.settings.delivery_title }}</span>
        {%- endif -%}
        {%- if block.settings.trust_logo_5 != blank -%}
          <span class="delivery-trust-block__logo">{{ block.settings.trust_logo_5 | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90,120,180', alt: block.settings.delivery_title }}</span>
        {%- endif -%}
        {%- if block.settings.trust_logo_6 != blank -%}
          <span class="delivery-trust-block__logo">{{ block.settings.trust_logo_6 | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90,120,180', alt: block.settings.delivery_title }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>
