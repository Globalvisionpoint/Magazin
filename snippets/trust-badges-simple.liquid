<div class="trust-badges-simple" style="padding: 1rem; border: 1px solid #ddd; border-radius: 8px; background: #f9f9f9;">
  <h3 style="color: {{ block.settings.trust_title_color }}; margin: 0 0 0.5rem 0;">{{ block.settings.trust_title }}</h3>
  <p style="color: {{ block.settings.trust_subtitle_color }}; margin: 0 0 0.5rem 0; font-weight: 600;">{{ block.settings.trust_subtitle }}</p>
  <p style="color: {{ block.settings.trust_text_color }}; margin: 0; font-size: 0.9rem;">{{ block.settings.trust_text }}</p>
</div>
