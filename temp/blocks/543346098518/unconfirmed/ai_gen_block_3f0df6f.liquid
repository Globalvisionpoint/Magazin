{% doc %}
  @prompt
    Create a new custom block for the product page template that displays a square card with:
    - A customizable image (set via theme editor)
    - A customizable text label (set via theme editor)
    - The entire card acts as a clickable button/link
    - A link picker in the theme editor settings that allows selecting a collection or product to link to
    - The block should have editor settings for: image, text, and link (product or collection picker)
    - Style it as a clean, clickable square card that fits a premium modern store aesthetic
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-clickable-card-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-clickable-card-link-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .ai-clickable-card-link-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
  }

  .ai-clickable-card-image-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-clickable-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-clickable-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.placeholder_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-clickable-card-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-clickable-card-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 4px;
  }

  .ai-clickable-card-overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: {{ block.settings.text_padding }}px;
    background: {{ block.settings.overlay_gradient }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-clickable-card-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    text-align: center;
    margin: 0;
    line-height: 1.3;
  }

  @media screen and (max-width: 749px) {
    .ai-clickable-card-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-clickable-card-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.85);
    }
  }
{% endstyle %}

<clickable-card-{{ ai_gen_id }} class="ai-clickable-card-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.card_link != blank %}
    <a href="{{ block.settings.card_link }}" class="ai-clickable-card-link-{{ ai_gen_id }}">
  {% else %}
    <div class="ai-clickable-card-link-{{ ai_gen_id }}">
  {% endif %}
    <div class="ai-clickable-card-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.card_image %}
        <img
          src="{{ block.settings.card_image | image_url: width: 800 }}"
          alt="{{ block.settings.card_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.card_image.width }}"
          height="{{ block.settings.card_image.height }}"
          class="ai-clickable-card-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-clickable-card-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-clickable-card-empty-state-{{ ai_gen_id }}">
            Add an image
          </div>
        </div>
      {% endif %}
    </div>

    {% if block.settings.card_text != blank %}
      <div class="ai-clickable-card-overlay-{{ ai_gen_id }}">
        <p class="ai-clickable-card-text-{{ ai_gen_id }}">{{ block.settings.card_text }}</p>
      </div>
    {% endif %}
  {% if block.settings.card_link != blank %}
    </a>
  {% else %}
    </div>
  {% endif %}
</clickable-card-{{ ai_gen_id }}>

<script>
  (function() {
    class ClickableCard{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const link = this.querySelector('.ai-clickable-card-link-{{ ai_gen_id }}');
        if (link && link.tagName === 'A') {
          link.addEventListener('click', function(e) {
            if (!e.ctrlKey && !e.metaKey) {
              const href = this.getAttribute('href');
              if (href && href !== '#') {
                window.location.href = href;
              }
            }
          });
        }
      }
    }

    customElements.define('clickable-card-{{ ai_gen_id }}', ClickableCard{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Clickable card",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Card content"
    },
    {
      "type": "image_picker",
      "id": "card_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "card_text",
      "label": "Text label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "card_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "placeholder_bg_color",
      "label": "Placeholder background",
      "default": "#f5f5f5"
    },
    {
      "type": "header",
      "content": "Text overlay"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color_background",
      "id": "overlay_gradient",
      "label": "Overlay gradient",
      "default": "linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.6) 100%)"
    },
    {
      "type": "range",
      "id": "text_padding",
      "label": "Text padding",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Clickable card"
    }
  ]
}
{% endschema %}
