{% doc %}
  @prompt
    Create a new custom block specifically for the main product section (product form area, where the buy button and add to cart are located) that displays a square card with:
    - A customizable image (set via theme editor)
    - A customizable text label (set via theme editor)
    - The entire card acts as a clickable button/link
    - A link picker in the theme editor settings that allows selecting a collection or product to link to
    - The block should have editor settings for: image, text, and link (product or collection picker)
    - Style it as a clean, clickable square card that fits a premium modern store aesthetic
    - This must be a block type that can be added inside the main product section (not a standalone section)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-link-card-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-product-link-card__wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    border-radius: 10px;
    background-color: #f1f3f7;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-product-link-card__wrapper-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
  }

  .ai-product-link-card__content-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
    text-decoration: none;
    color: inherit;
  }

  .ai-product-link-card__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
  }

  .ai-product-link-card__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 10px;
  }

  .ai-product-link-card__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f1f3f7;
    border-radius: 10px;
  }

  .ai-product-link-card__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-product-link-card__text-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 16px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
    color: #ffffff;
    font-size: {{ block.settings.text_size }}px;
    font-weight: 600;
    text-align: center;
    border-radius: 0 0 10px 10px;
  }

  .ai-product-link-card__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 13px;
    color: #666;
    text-align: center;
    pointer-events: none;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 4px;
  }

  @media screen and (max-width: 749px) {
    .ai-product-link-card__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.85 }}px;
      padding: 12px;
    }
  }
{% endstyle %}

<div class="ai-product-link-card-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.link != blank %}
    <a href="{{ block.settings.link }}" class="ai-product-link-card__wrapper-{{ ai_gen_id }}">
      <div class="ai-product-link-card__content-{{ ai_gen_id }}">
        <div class="ai-product-link-card__image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.image %}
            <img
              src="{{ block.settings.image | image_url: width: 600 }}"
              alt="{{ block.settings.image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              class="ai-product-link-card__image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-product-link-card__placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        {% if block.settings.text != blank %}
          <div class="ai-product-link-card__text-{{ ai_gen_id }}">
            {{ block.settings.text }}
          </div>
        {% endif %}
      </div>
    </a>
  {% else %}
    <div class="ai-product-link-card__wrapper-{{ ai_gen_id }}">
      <div class="ai-product-link-card__content-{{ ai_gen_id }}">
        <div class="ai-product-link-card__image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.image %}
            <img
              src="{{ block.settings.image | image_url: width: 600 }}"
              alt="{{ block.settings.image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              class="ai-product-link-card__image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-product-link-card__placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        {% if block.settings.text != blank %}
          <div class="ai-product-link-card__text-{{ ai_gen_id }}">
            {{ block.settings.text }}
          </div>
        {% endif %}
        {% if block.settings.image == blank or block.settings.text == blank or block.settings.link == blank %}
          <div class="ai-product-link-card__empty-state-{{ ai_gen_id }}">
            {% if block.settings.image == blank %}
              Adaugă o imagine
            {% elsif block.settings.text == blank %}
              Adaugă text
            {% elsif block.settings.link == blank %}
              Adaugă un link
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Product link card",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Conținut"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagine"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Descoperă colecția"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Stil"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Dimensiune text",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Product link card"
    }
  ]
}
{% endschema %}
