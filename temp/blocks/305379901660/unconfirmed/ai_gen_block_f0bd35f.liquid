{% doc %}
  @prompt
    Create a custom price display block that shows: the original (compare-at) price with a strikethrough next to the current sale price, and a discount percentage badge/label — but only when the product has a compare-at price set. The discount percentage should be calculated automatically as ((compare_at_price - price) / compare_at_price * 100) rounded to the nearest whole number. Style it cleanly with the sale price prominent, compare-at price crossed out in a muted color, and a bold red discount badge (e.g. "-25%"). Do not show anything extra when there is no compare-at price.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% if product.compare_at_price > product.price %}
  {% assign discount_percentage = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}

  {% style %}
    .ai-price-display-{{ ai_gen_id }} {
      display: flex;
      align-items: center;
      gap: 12px;
      width: {{ block.settings.desktop_width_percent }}%;
      max-width: 100%;
    }

    .ai-price-display__wrapper-{{ ai_gen_id }} {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .ai-price-display__sale-price-{{ ai_gen_id }} {
      font-size: {{ block.settings.sale_price_size }}px;
      font-weight: {{ block.settings.sale_price_weight }};
      color: {{ block.settings.sale_price_color }};
      line-height: 1.2;
    }

    .ai-price-display__compare-price-{{ ai_gen_id }} {
      font-size: {{ block.settings.compare_price_size }}px;
      font-weight: {{ block.settings.compare_price_weight }};
      color: {{ block.settings.compare_price_color }};
      text-decoration: line-through;
      line-height: 1.2;
    }

    .ai-price-display__badge-{{ ai_gen_id }} {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: {{ block.settings.badge_padding_vertical }}px {{ block.settings.badge_padding_horizontal }}px;
      background-color: {{ block.settings.badge_bg_color }};
      color: {{ block.settings.badge_text_color }};
      font-size: {{ block.settings.badge_font_size }}px;
      font-weight: {{ block.settings.badge_font_weight }};
      border-radius: {{ block.settings.badge_border_radius }}px;
      line-height: 1;
    }

    @media screen and (max-width: 749px) {
      .ai-price-display__sale-price-{{ ai_gen_id }} {
        font-size: calc({{ block.settings.sale_price_size }}px * 0.9);
      }

      .ai-price-display__compare-price-{{ ai_gen_id }} {
        font-size: calc({{ block.settings.compare_price_size }}px * 0.9);
      }

      .ai-price-display__badge-{{ ai_gen_id }} {
        font-size: calc({{ block.settings.badge_font_size }}px * 0.9);
      }
    }
  {% endstyle %}

  <div class="ai-price-display-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <div class="ai-price-display__wrapper-{{ ai_gen_id }}">
      <span class="ai-price-display__sale-price-{{ ai_gen_id }}">
        {{ product.price | money }}
      </span>
      <span class="ai-price-display__compare-price-{{ ai_gen_id }}">
        {{ product.compare_at_price | money }}
      </span>
    </div>
    <span class="ai-price-display__badge-{{ ai_gen_id }}">
      -{{ discount_percentage }}%
    </span>
  </div>
{% endif %}

{% schema %}
{
  "name": "Sale price display",
  "settings": [
    {
      "type": "header",
      "content": "Sale price"
    },
    {
      "type": "range",
      "id": "sale_price_size",
      "label": "Font size",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "sale_price_weight",
      "label": "Font weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "700"
    },
    {
      "type": "color",
      "id": "sale_price_color",
      "label": "Color",
      "default": "#c93131"
    },
    {
      "type": "header",
      "content": "Compare-at price"
    },
    {
      "type": "range",
      "id": "compare_price_size",
      "label": "Font size",
      "min": 10,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "select",
      "id": "compare_price_weight",
      "label": "Font weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    {
      "type": "color",
      "id": "compare_price_color",
      "label": "Color",
      "default": "#999999"
    },
    {
      "type": "header",
      "content": "Discount badge"
    },
    {
      "type": "range",
      "id": "badge_font_size",
      "label": "Font size",
      "min": 10,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "badge_font_weight",
      "label": "Font weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "700"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Background color",
      "default": "#c93131"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "badge_padding_vertical",
      "label": "Vertical padding",
      "min": 2,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "badge_padding_horizontal",
      "label": "Horizontal padding",
      "min": 4,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "badge_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Sale price display"
    }
  ],
  "tag": null
}
{% endschema %}
