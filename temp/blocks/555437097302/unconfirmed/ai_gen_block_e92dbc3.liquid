          "value": "return",
          "label": "Returnare"
        },
        {
          "value": "support",
          "label": "Suport"
        },
        {
          "value": "quality",
          "label": "Calitate"
        },
        {
          "value": "warranty",
          "label": "Garanție"
        }
      ],
      "default": "shipping"
    },
    {
      "type": "text",
      "id": "badge_1_title",
      "label": "Titlu",
      "default": "Livrare gratuită"
    },
    {
