    },
    {
      "type": "checkbox",
      "id": "badge_2_enabled",
      "label": "Activează insigna 2",
      "default": true
    },
    {
      "type": "select",
      "id": "badge_2_icon",
      "label": "Icon",
      "options": [
        {
          "value": "shipping",
          "label": "Livrare"
