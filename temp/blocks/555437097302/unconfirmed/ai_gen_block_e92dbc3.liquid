        <div class="ai-trust-badge-content-{{ ai_gen_id }}">
          {% if block.settings.badge_1_title != blank %}
            <div class="ai-trust-badge-title-{{ ai_gen_id }}">{{ block.settings.badge_1_title }}</div>
          {% endif %}
          {% if block.settings.badge_1_text != blank %}
            <div class="ai-trust-badge-text-{{ ai_gen_id }}">{{ block.settings.badge_1_text }}</div>
          {% endif %}
        </div>
      </div>
    {% endif %}

